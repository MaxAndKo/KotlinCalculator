<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <TextView
        android:id="@+id/math_operation"
        android:layout_width="match_parent"
        android:layout_height="80sp"
        android:textColor="@android:color/white"
        android:gravity="end"
        android:ellipsize="start"
        android:textSize="40sp"/>

    <TextView
        android:id="@+id/result_text"
        android:layout_width="match_parent"
        android:layout_height="100sp"
        android:textColor="@android:color/white"
        android:gravity="end"
        android:ellipsize="end"
        android:textSize="30sp"
        android:singleLine="true"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_weight="1"
            android:layout_width="match_parent"
            android:layout_height="0dp">
            <TextView style="@style/numberButton"
                android:text="AC"
                android:id="@+id/clear_btn"/>
            <TextView style="@style/numberButton"
                android:text="("
                android:id="@+id/open_brk_btn"/>
            <TextView style="@style/numberButton"
                android:text=")"
                android:id="@+id/close_brk_btn"/>
            <TextView style="@style/numberButton"
                android:text="/"
                android:id="@+id/divide_btn"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_weight="1"
            android:layout_width="match_parent"
            android:layout_height="0dp">

            <TextView style="@style/actionButton"
                android:text="7"
                android:id="@+id/btn_7"/>
            <TextView style="@style/actionButton"
                android:text="8"
                android:id="@+id/btn_8"/>
            <TextView style="@style/actionButton"
                android:text="9"
                android:id="@+id/btn_9"/>
            <TextView style="@style/numberButton"
                android:text="*"
                android:id="@+id/mult_btn"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_weight="1"
            android:layout_width="match_parent"
            android:layout_height="0dp">

            <TextView style="@style/actionButton"
                android:text="4"
                android:id="@+id/btn_4"/>
            <TextView style="@style/actionButton"
                android:text="5"
                android:id="@+id/btn_5"/>
            <TextView style="@style/actionButton"
                android:text="6"
                android:id="@+id/btn_6"/>
            <TextView style="@style/numberButton"
                android:text="+"
                android:id="@+id/plus_btn"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_weight="1"
            android:layout_width="match_parent"
            android:layout_height="0dp">

            <TextView style="@style/actionButton"
                android:text="1"
                android:id="@+id/btn_1"/>
            <TextView style="@style/actionButton"
                android:text="2"
                android:id="@+id/btn_2"/>
            <TextView style="@style/actionButton"
                android:text="3"
                android:id="@+id/btn_3"/>
            <TextView style="@style/numberButton"
                android:text="-"
                android:id="@+id/minus_btn"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_weight="1"
            android:layout_width="match_parent"
            android:layout_height="0dp">

            <TextView style="@style/actionButton"
                android:text="."
                android:id="@+id/dot_btn"/>
            <TextView style="@style/actionButton"
                android:text="0"
                android:id="@+id/btn_0"/>
            <TextView style="@style/actionButton"
                android:text="UNDO"
                android:id="@+id/undo_btn"/>
            <TextView style="@style/numberButton"
                android:text="="
                android:id="@+id/eq_btn"/>
        </LinearLayout>

    </LinearLayout>

</LinearLayout>